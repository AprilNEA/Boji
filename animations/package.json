{
  "name": "boji-exercise-animations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Generates the Boji exercise Lottie animations from a 2D rig.",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "tsx src/build.ts",
    "build:assets": "tsx src/build-assets.ts",
    "check": "tsx scripts/check.ts",
    "typecheck": "tsc --noEmit",
    "preview": "tsx scripts/preview.ts",
    "sheets": "tsx scripts/sheet.ts",
    "gallery": "tsx scripts/gallery.ts",
    "family": "tsx scripts/family.ts",
    "render": "tsx scripts/render.ts .renders 8 '#F7F5F0'"
  },
  "devDependencies": {
    "@types/bezier-js": "^4.1.3",
    "@types/d3-color": "^3.1.3",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-path": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.5",
    "lottie-web": "^5.13.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "bezier-js": "^6.1.4",
    "d3-color": "^3.1.0",
    "d3-ease": "^3.0.1",
    "d3-interpolate": "^3.0.1",
    "d3-path": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "es-toolkit": "^1.52.0",
    "gl-matrix": "^3.4.4",
    "svgpath": "^2.6.0"
  }
}
