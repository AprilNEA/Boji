<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The member service and Sentry crash reports use the network. The Sentry SDK also merges this permission. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Body records are sensitive personal data. Backup and device transfer stay off
        until the Android data layer defines what may leave the device.
        API 26-30: allowBackup="false" disables every backup type, so fullBackupContent is not needed.
        API 31+: allowBackup="false" stops cloud backup; dataExtractionRules also stops device transfer.

        CredManMissingDal: Credential Manager saves and fills passwords without Digital Asset Links.
        The links share passwords with the club website, and need a domain that serves
        /.well-known/assetlinks.json with the release signing certificate fingerprint. That domain
        does not exist yet (iOS has no webcredentials domain either). When it exists, add the
        asset_statements meta-data here and remove CredManMissingDal from tools:ignore.
    -->
    <application
        android:name=".BojiApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Boji"
        tools:ignore="DataExtractionRules,CredManMissingDal"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares the member card image that the user confirms in the share preview. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!--
            CrashReporting starts Sentry in BojiApplication only when the build sets a DSN.
            These SDK providers would start it automatically, so the merged manifest drops them.
        -->
        <provider
            android:name="io.sentry.android.core.SentryInitProvider"
            android:authorities="${applicationId}.SentryInitProvider"
            tools:node="remove" />
        <provider
            android:name="io.sentry.android.core.SentryPerformanceProvider"
            android:authorities="${applicationId}.SentryPerformanceProvider"
            tools:node="remove" />
    </application>

</manifest>
