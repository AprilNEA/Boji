<?xml version="1.0" encoding="utf-8"?>
<!--
    Release builds send traffic over TLS only and trust the system certificate store.
    src/debug/res/xml/network_security_config.xml replaces this file in debug builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
