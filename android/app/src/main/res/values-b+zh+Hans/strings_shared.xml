    <!-- exercise -->
    <string name="exercise_bodyweight_squat_name">徒手深蹲</string>
    <string name="exercise_bodyweight_squat_tip">膝盖朝脚尖方向，缓慢起身。</string>
    <string name="exercise_wall_push_up_name">墙壁俯卧撑</string>
    <string name="exercise_wall_push_up_tip">身体保持直线，双手稳稳撑墙。</string>
    <string name="exercise_glute_bridge_name">臀桥</string>
    <string name="exercise_glute_bridge_tip">脚掌踩稳，抬起时不要耸肩。</string>
    <string name="exercise_bird_dog_name">鸟狗式</string>
    <string name="exercise_bird_dog_tip">动作放慢，保持躯干稳定。</string>
    <string name="exercise_reverse_lunge_name">后撤步弓步蹲</string>
    <string name="exercise_reverse_lunge_tip">后撤一步再下蹲，前膝对准脚尖。</string>
    <string name="exercise_knee_push_up_name">跪姿俯卧撑</string>
    <string name="exercise_knee_push_up_tip">膝盖到头保持一条直线，胸口慢慢下放。</string>
    <string name="exercise_dead_bug_name">死虫式</string>
    <string name="exercise_dead_bug_tip">腰背贴住地面，对侧手脚慢慢伸出。</string>
    <string name="exercise_wall_sit_name">靠墙静蹲</string>
    <string name="exercise_wall_sit_tip">背部贴墙，大腿与地面平行。</string>
    <string name="exercise_plank_name">平板支撑</string>
    <string name="exercise_plank_tip">肘在肩正下方，身体保持一条直线。</string>
    <string name="exercise_chest_press_name">坐姿推胸</string>
    <string name="exercise_chest_press_tip">选择轻重量，背部贴稳靠垫。</string>
    <string name="exercise_seated_row_name">坐姿划船</string>
    <string name="exercise_seated_row_tip">拉向身体时保持肩部放松。</string>
    <string name="exercise_leg_press_name">坐姿腿举</string>
    <string name="exercise_leg_press_tip">使用可控重量，膝盖不要锁死。</string>
    <string name="exercise_lat_pulldown_name">高位下拉</string>
    <string name="exercise_lat_pulldown_tip">轻拉横杆，避免身体后仰。</string>
    <string name="exercise_cat_cow_name">猫牛式</string>
    <string name="exercise_cat_cow_tip">配合呼吸，动作保持柔和。</string>
    <string name="exercise_hip_flexor_stretch_name">髋屈肌拉伸</string>
    <string name="exercise_hip_flexor_stretch_tip">骨盆保持平稳，不要弹震。</string>
    <string name="exercise_chest_stretch_name">开胸拉伸</string>
    <string name="exercise_chest_stretch_tip">轻轻打开胸部，肩膀自然下沉。</string>
    <string name="exercise_push_up_name">俯卧撑</string>
    <string name="exercise_push_up_tip">身体保持一条直线，胸口贴近地面再推起。</string>
    <string name="exercise_bodyweight_split_squat_name">分腿蹲</string>
    <string name="exercise_bodyweight_split_squat_tip">前后脚站定，身体垂直下沉，用前脚跟发力站起。</string>
    <string name="exercise_single_leg_glute_bridge_name">单腿臀桥</string>
    <string name="exercise_single_leg_glute_bridge_tip">一侧膝盖收向胸口，用另一只脚的脚跟把臀部推高。</string>
    <string name="exercise_bench_dip_name">反向臂屈伸</string>
    <string name="exercise_bench_dip_tip">双手撑在身后稳固的椅子边缘，屈肘到约 90 度。</string>
    <string name="exercise_superman_name">超人式</string>
    <string name="exercise_superman_tip">手臂和双腿同时抬离地面，颈部保持放松。</string>
    <string name="exercise_bodyweight_forearm_side_plank_name">侧平板支撑</string>
    <string name="exercise_bodyweight_forearm_side_plank_tip">肘部在肩膀正下方，髋部不要下沉。</string>
    <string name="exercise_crunch_name">卷腹</string>
    <string name="exercise_crunch_tip">用腹部带动上背抬起，下背贴住地面。</string>
    <string name="exercise_reverse_crunch_name">反向卷腹</string>
    <string name="exercise_reverse_crunch_tip">卷起骨盆让膝盖靠近胸口，再慢慢放回。</string>
    <string name="exercise_bicycle_crunch_name">自行车卷腹</string>
    <string name="exercise_bicycle_crunch_tip">肘部转向对侧膝盖，不要用手拉脖子。</string>
    <string name="exercise_russian_twist_name">俄罗斯转体</string>
    <string name="exercise_russian_twist_tip">双脚离地，背部挺直，用胸廓带动左右转动。</string>
    <string name="exercise_flutter_kick_name">仰卧交替踢腿</string>
    <string name="exercise_flutter_kick_tip">下背贴紧地面，双腿伸直，小幅交替上下。</string>
    <string name="exercise_jumping_jack_name">开合跳</string>
    <string name="exercise_jumping_jack_tip">落地时膝盖微屈，双臂在头顶上方合拢。</string>
    <string name="exercise_wall_high_knees_name">扶墙高抬腿</string>
    <string name="exercise_wall_high_knees_tip">双手扶墙，膝盖交替抬向胸口。</string>
    <string name="exercise_mountain_climber_name">登山者</string>
    <string name="exercise_mountain_climber_tip">双手撑在肩膀正下方，膝盖交替提向胸口。</string>
    <string name="exercise_jump_squat_name">深蹲跳</string>
    <string name="exercise_jump_squat_tip">双臂交叉在胸前，落地时顺势回到深蹲。</string>
    <string name="exercise_bear_crawl_name">熊爬</string>
    <string name="exercise_bear_crawl_tip">膝盖离地几厘米，对侧的手和脚同时向前。</string>
    <string name="exercise_bodyweight_burpee_name">波比跳</string>
    <string name="exercise_bodyweight_burpee_tip">按自己的节奏完成，落地时膝盖微屈。</string>
    <string name="exercise_dumbbell_goblet_squat_name">高脚杯深蹲</string>
    <string name="exercise_dumbbell_goblet_squat_tip">哑铃贴近胸口，背部挺直下蹲。</string>
    <string name="exercise_dumbbell_floor_press_name">哑铃地板卧推</string>
    <string name="exercise_dumbbell_floor_press_tip">上臂轻触地面后再推起。</string>
    <string name="exercise_dumbbell_bent_over_row_name">哑铃俯身划船</string>
    <string name="exercise_dumbbell_bent_over_row_tip">背部挺直，手肘贴近身体，把哑铃拉向腰部。</string>
    <string name="exercise_dumbbell_romanian_deadlift_name">哑铃罗马尼亚硬拉</string>
    <string name="exercise_dumbbell_romanian_deadlift_tip">臀部向后推，哑铃贴着大腿下放。</string>
    <string name="exercise_dumbbell_reverse_lunge_name">哑铃后撤弓步蹲</string>
    <string name="exercise_dumbbell_reverse_lunge_tip">后撤一步再下蹲，躯干保持直立。</string>
    <string name="exercise_dumbbell_lateral_raise_name">哑铃侧平举</string>
    <string name="exercise_dumbbell_lateral_raise_tip">手肘微屈，举到与肩同高即可。</string>
    <string name="exercise_dumbbell_bench_press_name">哑铃卧推</string>
    <string name="exercise_dumbbell_bench_press_tip">双脚踩稳，屈肘到约 90 度再推起。</string>
    <string name="exercise_dumbbell_seated_shoulder_press_name">哑铃坐姿推举</string>
    <string name="exercise_dumbbell_seated_shoulder_press_tip">背部靠稳，向上推时不要耸肩。</string>
    <string name="exercise_dumbbell_biceps_curl_name">哑铃弯举</string>
    <string name="exercise_dumbbell_biceps_curl_tip">上臂贴近身体，不要借力摆动。</string>
    <string name="exercise_machine_chest_press_name">器械推胸</string>
    <string name="exercise_machine_chest_press_tip">背部靠紧靠垫，推到手肘接近伸直，不要锁死。</string>
    <string name="exercise_machine_shoulder_press_name">器械肩上推举</string>
    <string name="exercise_machine_shoulder_press_tip">背部贴紧靠背，平稳向上推。</string>
    <string name="exercise_machine_assisted_pull_up_name">辅助引体向上</string>
    <string name="exercise_machine_assisted_pull_up_tip">下巴过把手后慢慢放下，身体不要摆动。</string>
    <string name="exercise_machine_pec_deck_fly_name">蝴蝶机夹胸</string>
    <string name="exercise_machine_pec_deck_fly_tip">手肘微屈，在胸前合拢后慢慢打开。</string>
    <string name="exercise_cable_face_pull_name">绳索面拉</string>
    <string name="exercise_cable_face_pull_tip">把绳索拉向面部，双手向两侧分开，上臂保持水平。</string>
    <string name="exercise_cable_rope_triceps_pushdown_name">绳索下压</string>
    <string name="exercise_cable_rope_triceps_pushdown_tip">上臂贴紧身体，只动前臂。</string>
    <string name="exercise_machine_leg_extension_name">坐姿腿屈伸</string>
    <string name="exercise_machine_leg_extension_tip">膝盖对准器械转轴，伸直时稍作停顿，再慢慢放下。</string>
    <string name="exercise_machine_seated_leg_curl_name">坐姿腿弯举</string>
    <string name="exercise_machine_seated_leg_curl_tip">大腿用压垫固定，小腿向座椅下方弯曲。</string>
    <string name="exercise_machine_seated_hip_abduction_name">坐姿髋外展</string>
    <string name="exercise_machine_seated_hip_abduction_tip">背部靠稳，双膝向外推开，稍作停顿。</string>
    <string name="exercise_machine_seated_hip_adduction_name">坐姿髋内收</string>
    <string name="exercise_machine_seated_hip_adduction_tip">双膝向内夹紧，再慢慢回到起始位置。</string>
    <string name="exercise_back_extension_name">罗马椅背部伸展</string>
    <string name="exercise_back_extension_tip">起身到身体与双腿成一条直线即可，不要过度后仰。</string>
    <string name="exercise_standing_hamstring_stretch_name">站姿腘绳肌拉伸</string>
    <string name="exercise_standing_hamstring_stretch_tip">前腿伸直，背部挺直，从髋部向前倾。</string>
    <string name="exercise_prone_quadriceps_stretch_name">俯卧股四头肌拉伸</string>
    <string name="exercise_prone_quadriceps_stretch_tip">手握脚踝，把脚跟拉向臀部，髋部贴住地面。</string>
    <string name="exercise_supine_figure_four_glute_stretch_name">仰卧四字臀肌拉伸</string>
    <string name="exercise_supine_figure_four_glute_stretch_tip">一侧脚踝搭在另一侧膝盖上，双手把腿拉向胸口。</string>
    <string name="exercise_runners_lunge_stretch_name">弓步拉伸</string>
    <string name="exercise_runners_lunge_stretch_tip">双手撑在前脚两侧，臀部向后抬，拉伸前腿后侧。</string>
    <string name="exercise_wall_standing_calf_stretch_name">扶墙小腿拉伸</string>
    <string name="exercise_wall_standing_calf_stretch_tip">后腿伸直，后脚跟踩实地面，身体向墙前倾。</string>
    <string name="exercise_neck_side_stretch_name">颈部侧屈拉伸</string>
    <string name="exercise_neck_side_stretch_tip">耳朵慢慢靠向肩膀，肩膀保持放松。</string>
    <string name="exercise_cross_body_shoulder_stretch_name">交叉抱臂肩部拉伸</string>
    <string name="exercise_cross_body_shoulder_stretch_tip">一侧手臂横过胸前，另一只手托住手肘，肩膀不要抬起。</string>
    <string name="exercise_overhead_triceps_stretch_name">过顶肱三头肌拉伸</string>
    <string name="exercise_overhead_triceps_stretch_tip">一只手放到脑后，另一只手轻拉这侧手肘。</string>
    <string name="exercise_chair_seated_chest_and_shoulder_stretch_name">坐姿开胸拉伸</string>
