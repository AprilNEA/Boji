<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy that only Android shows. This directory is the fallback language, English.
  values-b+zh+Hans/strings.xml holds the Simplified Chinese copy with the same names.
  Copy that iOS also shows lives in locales/ and is generated into strings_shared.xml.
-->
<resources>
    <!-- Working name, same as iOS. Trademark clearance is pending. -->
    <string name="app_name">Lean Muscle</string>


    <!-- Common -->
    <string name="action_back">Back</string>
    <string name="stepper_decrease">Decrease</string>
    <string name="stepper_increase">Increase</string>
    <string name="storage_unknown_error">Unknown error</string>


    <!-- Welcome -->
    <string name="welcome_brand" translatable="false">boji</string>

    <!-- Today -->
    <string name="today_subtitle">No need to get there in one go. Every step counts.</string>
    <string name="today_rhythm_a11y">My daily rhythm: %1$d of %2$d logged</string>
    <string name="habit_move">Move</string>
    <string name="habit_water">Water</string>
    <string name="habit_status">%1$s: %2$s</string>
    <string name="habit_log">Log it</string>
    <string name="workout_card_eyebrow">MOVE AT YOUR PACE</string>
    <string name="workout_card_meta">%1$d min · %2$s</string>
    <string name="workout_card_action">View Workout</string>


    <!-- Entry sheets -->
    <string name="water_amount_label">This Drink</string>
    <string name="water_undo">Undo 250 mL</string>
    <string name="sleep_label">Slept Last Night</string>
    <string name="sleep_value">%1$s h</string>
    <string name="sleep_slider_a11y">Hours of sleep</string>
    <string name="sleep_adjust">Adjust Duration</string>
    <string name="body_weight_invalid">Enter a value from 30 to 300</string>
    <string name="body_waist_invalid">Enter a value from 30 to 250</string>

    <!-- Training -->
    <string name="training_eyebrow">BUILD YOUR OWN RHYTHM</string>
    <string name="training_subtitle">Make starting easy. Let time take care of the rest.</string>
    <string name="training_disclaimer">Courses are general starting points, not personal prescriptions. If you have an injury or exercise limits, talk to a professional first. Stop at once if you feel pain, dizziness or discomfort.</string>
    <string name="detail_warmup">Warm up first. Keep each move comfortable and controlled.</string>

    <!-- Training session -->
    <string name="session_title">Stay Present</string>
    <string name="session_progress_a11y">%1$d of %2$d sets done</string>
    <plurals name="session_rest_a11y">
        <item quantity="one">%1$d second of rest left</item>
        <item quantity="other">%1$d seconds of rest left</item>
    </plurals>
    <string name="session_footnote">Go at your own pace and continue when you’re ready.\nIf you feel pain or discomfort, stop the workout.</string>
    <string name="session_end_confirm_title">End this workout?</string>
    <string name="session_end_confirm_text">An unfinished workout won’t be saved.</string>
    <string name="session_finished_summary">%1$s logged\nTime: %2$d min %3$d sec</string>

    <!-- Progress -->
    <string name="progress_eyebrow">EVERY LITTLE STEP COUNTS</string>
    <string name="progress_title">See how you change.</string>
    <string name="progress_active_days">Active Days</string>
    <string name="progress_week_detail">Move / Water / Sleep</string>
    <string name="progress_week_day_active">%1$s, logged</string>
    <string name="progress_week_day_empty">%1$s, nothing logged</string>
    <plurals name="progress_chart_a11y">
        <item quantity="one">Body record trend, %1$d entry. The values are listed below.</item>
        <item quantity="other">Body record trend, %1$d entries. The values are listed below.</item>
    </plurals>
    <string name="progress_entry_value">%1$s %2$s</string>
    <string name="progress_entry_manage">Manage the entry for %1$s</string>
    <string name="progress_share_title">Share My Small Wins</string>

    <!-- Club -->
    <string name="club_subtitle">Here, taking care of yourself is your ticket in.</string>
    <string name="club_membership_title">Membership Card</string>
    <string name="club_membership_text">The Android app doesn’t support club accounts or membership cards yet. Daily logging doesn’t need an account.</string>
    <string name="club_challenge_day">Day %1$d: %2$s</string>
    <string name="club_challenge_day_done">Done</string>
    <string name="club_challenge_day_pending">Not yet</string>
    <string name="club_footnote">Your daily records stay on this device. Membership cards, group squads and the online community aren’t available on Android yet.</string>

    <!-- Settings -->
    <string name="settings_privacy_local">Workout and body records stay on this device only</string>
    <string name="settings_privacy_note">Records are not uploaded. System backup and device transfer don’t include them, and uninstalling the app deletes them. The export file contains body data, so keep it safe.</string>
    <string name="settings_export_done">Exported to the selected location</string>
    <string name="settings_export_filename" translatable="false">boji-records.json</string>
    <string name="settings_delete_confirm_text">This can’t be undone. It deletes the workout, water, sleep and body records on this device, plus your nickname and training setting. Display mode stays the same.</string>
    <string name="settings_about_note">Lean Muscle Club · Developer Preview\nNo medical diagnosis, AI meal recognition or paid services. The name is a working name and has not completed trademark review.</string>
</resources>
