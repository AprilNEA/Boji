    <string name="exercise_bodyweight_squat_name">Bodyweight Squat</string>
    <string name="exercise_bodyweight_squat_tip">Point your knees toward your toes and rise slowly.</string>
    <string name="exercise_wall_push_up_name">Wall Push-Up</string>
    <string name="exercise_wall_push_up_tip">Keep your body in a straight line and your hands steady on the wall.</string>
    <string name="exercise_glute_bridge_name">Glute Bridge</string>
    <string name="exercise_glute_bridge_tip">Plant your feet and don’t shrug as you lift.</string>
    <string name="exercise_bird_dog_name">Bird Dog</string>
    <string name="exercise_bird_dog_tip">Move slowly and keep your torso stable.</string>
    <string name="exercise_reverse_lunge_name">Reverse Lunge</string>
    <string name="exercise_reverse_lunge_tip">Step back, then lower. Keep your front knee in line with your toes.</string>
    <string name="exercise_knee_push_up_name">Knee Push-Up</string>
    <string name="exercise_knee_push_up_tip">Keep a straight line from knees to head and lower your chest slowly.</string>
    <string name="exercise_dead_bug_name">Dead Bug</string>
    <string name="exercise_dead_bug_tip">Keep your lower back on the floor and slowly extend the opposite arm and leg.</string>
    <string name="exercise_wall_sit_name">Wall Sit</string>
    <string name="exercise_wall_sit_tip">Keep your back on the wall and your thighs parallel to the floor.</string>
    <string name="exercise_plank_name">Plank</string>
    <string name="exercise_plank_tip">Keep your elbows under your shoulders and your body in one straight line.</string>
    <string name="exercise_chest_press_name">Seated Chest Press</string>
    <string name="exercise_chest_press_tip">Choose a light weight and keep your back against the pad.</string>
    <string name="exercise_seated_row_name">Seated Row</string>
    <string name="exercise_seated_row_tip">Keep your shoulders relaxed as you pull toward your body.</string>
    <string name="exercise_leg_press_name">Seated Leg Press</string>
    <string name="exercise_leg_press_tip">Use a weight you can control and don’t lock your knees.</string>
    <string name="exercise_lat_pulldown_name">Lat Pulldown</string>
    <string name="exercise_lat_pulldown_tip">Pull the bar down gently and don’t lean back.</string>
    <string name="exercise_cat_cow_name">Cat-Cow</string>
    <string name="exercise_cat_cow_tip">Move with your breath and keep it gentle.</string>
    <string name="exercise_hip_flexor_stretch_name">Hip Flexor Stretch</string>
    <string name="exercise_hip_flexor_stretch_tip">Keep your pelvis steady and don’t bounce.</string>
    <string name="exercise_chest_stretch_name">Chest Opener</string>
    <string name="exercise_chest_stretch_tip">Gently open your chest and let your shoulders drop.</string>
    <string name="exercise_push_up_name">Push-Up</string>
    <string name="exercise_push_up_tip">Keep your body in a straight line and lower your chest close to the floor.</string>
    <string name="exercise_bodyweight_split_squat_name">Split Squat</string>
    <string name="exercise_bodyweight_split_squat_tip">Keep your stance fixed, lower straight down and drive up through your front heel.</string>
    <string name="exercise_single_leg_glute_bridge_name">Single-Leg Glute Bridge</string>
    <string name="exercise_single_leg_glute_bridge_tip">Hold one knee toward your chest and push your hips up through the other heel.</string>
    <string name="exercise_bench_dip_name">Bench Dip</string>
    <string name="exercise_bench_dip_tip">Grip the edge of a sturdy chair or bench behind you and bend your elbows to about 90 degrees.</string>
    <string name="exercise_superman_name">Superman</string>
    <string name="exercise_superman_tip">Lift your arms and legs together and keep your neck relaxed.</string>
    <string name="exercise_bodyweight_forearm_side_plank_name">Side Plank</string>
    <string name="exercise_bodyweight_forearm_side_plank_tip">Keep your elbow under your shoulder and don’t let your hips sag.</string>
    <string name="exercise_crunch_name">Crunch</string>
    <string name="exercise_crunch_tip">Lift your upper back with your abs and keep your lower back on the mat.</string>
    <string name="exercise_reverse_crunch_name">Reverse Crunch</string>
    <string name="exercise_reverse_crunch_tip">Curl your pelvis to bring your knees toward your chest, then lower slowly.</string>
    <string name="exercise_bicycle_crunch_name">Bicycle Crunch</string>
    <string name="exercise_bicycle_crunch_tip">Turn your elbow toward the opposite knee, and don’t pull on your neck.</string>
    <string name="exercise_russian_twist_name">Russian Twist</string>
    <string name="exercise_russian_twist_tip">Lift your feet, keep your back straight and turn your rib cage side to side.</string>
    <string name="exercise_flutter_kick_name">Flutter Kick</string>
    <string name="exercise_flutter_kick_tip">Press your lower back into the mat and make small, alternating kicks with straight legs.</string>
    <string name="exercise_jumping_jack_name">Jumping Jack</string>
    <string name="exercise_jumping_jack_tip">Land with soft knees and bring your arms together overhead.</string>
    <string name="exercise_wall_high_knees_name">Wall High Knees</string>
    <string name="exercise_wall_high_knees_tip">Keep your hands on the wall and drive each knee toward your chest in turn.</string>
    <string name="exercise_mountain_climber_name">Mountain Climber</string>
    <string name="exercise_mountain_climber_tip">Keep your hands under your shoulders and drive your knees toward your chest in turn.</string>
    <string name="exercise_jump_squat_name">Jump Squat</string>
    <string name="exercise_jump_squat_tip">Cross your arms over your chest and land softly back into the squat.</string>
    <string name="exercise_bear_crawl_name">Bear Crawl</string>
    <string name="exercise_bear_crawl_tip">Hover your knees just off the floor and move your opposite hand and foot together.</string>
    <string name="exercise_bodyweight_burpee_name">Burpee</string>
    <string name="exercise_bodyweight_burpee_tip">Move at your own pace and land with soft knees.</string>
    <string name="exercise_dumbbell_goblet_squat_name">Goblet Squat</string>
    <string name="exercise_dumbbell_goblet_squat_tip">Hold the dumbbell close to your chest and keep your back straight as you squat.</string>
    <string name="exercise_dumbbell_floor_press_name">Dumbbell Floor Press</string>
    <string name="exercise_dumbbell_floor_press_tip">Let your upper arms touch the floor lightly, then press up.</string>
    <string name="exercise_dumbbell_bent_over_row_name">Dumbbell Bent-Over Row</string>
    <string name="exercise_dumbbell_bent_over_row_tip">Keep your back flat and your elbows close as you pull the dumbbells toward your waist.</string>
    <string name="exercise_dumbbell_romanian_deadlift_name">Dumbbell Romanian Deadlift</string>
    <string name="exercise_dumbbell_romanian_deadlift_tip">Push your hips back and keep the dumbbells close to your legs.</string>
    <string name="exercise_dumbbell_reverse_lunge_name">Dumbbell Reverse Lunge</string>
    <string name="exercise_dumbbell_reverse_lunge_tip">Step back, then lower, keeping your torso upright.</string>
    <string name="exercise_dumbbell_lateral_raise_name">Dumbbell Lateral Raise</string>
    <string name="exercise_dumbbell_lateral_raise_tip">Keep a slight bend in your elbows and raise only to shoulder height.</string>
    <string name="exercise_dumbbell_bench_press_name">Dumbbell Bench Press</string>
    <string name="exercise_dumbbell_bench_press_tip">Plant your feet, bend your elbows to about 90 degrees, then press up.</string>
    <string name="exercise_dumbbell_seated_shoulder_press_name">Seated Dumbbell Shoulder Press</string>
    <string name="exercise_dumbbell_seated_shoulder_press_tip">Keep your back against the bench and don’t shrug as you press.</string>
    <string name="exercise_dumbbell_biceps_curl_name">Dumbbell Biceps Curl</string>
    <string name="exercise_dumbbell_biceps_curl_tip">Keep your upper arms by your sides and don’t swing.</string>
    <string name="exercise_machine_chest_press_name">Machine Chest Press</string>
    <string name="exercise_machine_chest_press_tip">Keep your back against the pad and press until your elbows are almost straight.</string>
    <string name="exercise_machine_shoulder_press_name">Machine Shoulder Press</string>
    <string name="exercise_machine_shoulder_press_tip">Keep your back against the backrest and press up smoothly.</string>
    <string name="exercise_machine_assisted_pull_up_name">Assisted Pull-Up</string>
    <string name="exercise_machine_assisted_pull_up_tip">Pull until your chin clears the handles, then lower slowly without swinging.</string>
    <string name="exercise_machine_pec_deck_fly_name">Pec Deck Fly</string>
    <string name="exercise_machine_pec_deck_fly_tip">Keep a slight bend in your elbows, bring the handles together, then open slowly.</string>
    <string name="exercise_cable_face_pull_name">Cable Face Pull</string>
    <string name="exercise_cable_face_pull_tip">Pull the rope toward your face and spread your hands, keeping your upper arms level.</string>
    <string name="exercise_cable_rope_triceps_pushdown_name">Rope Triceps Pushdown</string>
    <string name="exercise_cable_rope_triceps_pushdown_tip">Keep your upper arms at your sides and move only your forearms.</string>
    <string name="exercise_machine_leg_extension_name">Leg Extension</string>
    <string name="exercise_machine_leg_extension_tip">Line up your knees with the machine’s pivot, pause at the top and lower slowly.</string>
    <string name="exercise_machine_seated_leg_curl_name">Seated Leg Curl</string>
    <string name="exercise_machine_seated_leg_curl_tip">Keep your thighs under the pad and curl your lower legs under the seat.</string>
    <string name="exercise_machine_seated_hip_abduction_name">Seated Hip Abduction</string>
    <string name="exercise_machine_seated_hip_abduction_tip">Keep your back against the pad, push your knees apart and pause.</string>
    <string name="exercise_machine_seated_hip_adduction_name">Seated Hip Adduction</string>
    <string name="exercise_machine_seated_hip_adduction_tip">Squeeze your knees together, then return slowly.</string>
    <string name="exercise_back_extension_name">Back Extension</string>
    <string name="exercise_back_extension_tip">Rise until your body lines up with your legs, and don’t arch past it.</string>
    <string name="exercise_standing_hamstring_stretch_name">Standing Hamstring Stretch</string>
    <string name="exercise_standing_hamstring_stretch_tip">Keep your front leg straight and your back flat as you lean forward from your hips.</string>
    <string name="exercise_prone_quadriceps_stretch_name">Prone Quad Stretch</string>
    <string name="exercise_prone_quadriceps_stretch_tip">Hold your ankle and draw your heel toward your glutes, keeping your hips down.</string>
    <string name="exercise_supine_figure_four_glute_stretch_name">Figure-Four Glute Stretch</string>
    <string name="exercise_supine_figure_four_glute_stretch_tip">Cross one ankle over the other knee and draw your legs toward your chest.</string>
    <string name="exercise_runners_lunge_stretch_name">Runner’s Lunge Stretch</string>
    <string name="exercise_runners_lunge_stretch_tip">Plant your hands beside your front foot and shift your hips back to stretch the back of your front leg.</string>
    <string name="exercise_wall_standing_calf_stretch_name">Wall Calf Stretch</string>
    <string name="exercise_wall_standing_calf_stretch_tip">Keep your back leg straight and your heel down as you lean toward the wall.</string>
    <string name="exercise_neck_side_stretch_name">Neck Side Stretch</string>
    <string name="exercise_neck_side_stretch_tip">Tilt your ear slowly toward your shoulder and keep your shoulders relaxed.</string>
    <string name="exercise_cross_body_shoulder_stretch_name">Cross-Body Shoulder Stretch</string>
    <string name="exercise_cross_body_shoulder_stretch_tip">Bring one arm across your chest, support the elbow with the other hand and keep your shoulder down.</string>
    <string name="exercise_overhead_triceps_stretch_name">Overhead Triceps Stretch</string>
    <string name="exercise_overhead_triceps_stretch_tip">Reach one hand behind your head and gently pull that elbow with the other hand.</string>
    <string name="exercise_chair_seated_chest_and_shoulder_stretch_name">Seated Chest Opener</string>
    <string name="exercise_chair_seated_chest_and_shoulder_stretch_tip">Sit at the front of the chair, hold the chair back behind you and lift your chest forward.</string>
    <string name="exercise_seated_chair_hamstring_stretch_name">Seated Hamstring Stretch</string>
    <string name="exercise_seated_chair_hamstring_stretch_tip">Sit at the front of the chair, straighten one leg with the heel down and lean forward from your hips.</string>
    <string name="exercise_worlds_greatest_stretch_name">World’s Greatest Stretch</string>
    <string name="exercise_worlds_greatest_stretch_tip">From a lunge, bring your elbow toward the inside of your front foot, then straighten your front leg.</string>
    <string name="exercise_inchworm_name">Inchworm</string>
    <string name="exercise_inchworm_tip">Keep your hands planted and your legs straight, walk your feet toward your hands, then return to a plank.</string>
    <string name="exercise_bodyweight_good_morning_name">Bodyweight Good Morning</string>
    <string name="exercise_bodyweight_good_morning_tip">Soften your knees, push your hips back and keep your back flat.</string>
    <string name="exercise_knees_to_chest_stretch_name">Knees-to-Chest Stretch</string>
    <string name="exercise_knees_to_chest_stretch_tip">Hold your shins and draw your knees toward your chest, letting your lower back rest on the floor.</string>
    <string name="exercise_childs_pose_name">Child’s Pose</string>
    <string name="exercise_childs_pose_tip">Keep your hands in place and sit your hips back onto your heels.</string>
