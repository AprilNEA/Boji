    "club_challenge_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick two days to move, and recover well the rest of the time. This is your local challenge: no rankings, no rush."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择两天动一动，其余时间好好恢复。这是你的本地挑战，不排名，也不催促。"
          }
        }
      }
    },
    "club_challenge_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make a Little Time for Yourself This Week"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这周，为自己留一点时间"
          }
        }
      }
    },
    "club_eyebrow" : {
      "extractionState" : "manual",
      "localizations" : {
