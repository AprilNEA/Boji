      }
    },
    "body_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data stays on this device. Measure at a similar time and in similar conditions, and look at long-term changes. There is no ideal weight here, and no judgment about your body."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据仅保存在此设备。建议在相近时间和条件下测量，关注长期变化。这里不设理想体重，也不评判身材。"
          }
        }
      }
    },
    "body_section" : {
