    "article_eat_well_category" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyday Eating"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "饮食日常"
          }
        }
      }
    },
    "article_eat_well_s1_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start with regular meals. You don’t need to go hungry to get toned. Giving yourself a full meal lasts longer than chasing a perfect meal plan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从规律吃饭开始，不用靠挨饿换取线条。为自己留出完整的一餐，比追求一份完美食谱更可持续。"
          }
        }
      }
    },
    "article_eat_well_s1_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eat regularly first"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先吃得规律"
          }
        }
      }
    },
    "article_eat_well_s2_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grains, vegetables and protein foods all belong on your plate. Choose by taste and what you have. You don’t need special supplements."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主食、蔬菜和蛋白质食物都可以出现在餐盘里。根据口味和条件选择，不必购买特定补剂。"
          }
        }
      }
    },
    "article_eat_well_s2_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add some variety to your plate"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让餐盘丰富一点"
          }
        }
      }
    },
    "article_eat_well_s3_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An occasional meal out won’t erase your effort. You don’t need to exercise as punishment after eating. If you have a medical condition or special nutritional needs, talk to a professional."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偶尔的聚餐不会抹去你的努力。吃完不需要惩罚式运动。有疾病或特殊营养需求时，咨询专业人员。"
          }
        }
      }
    },
    "article_eat_well_s3_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Food isn’t good or bad"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不把食物分成好坏"
          }
        }
      }
    },
    "article_eat_well_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eating Well Beats a Perfect Meal Plan"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好好吃饭，比完美食谱重要"
          }
        }
      }
    },
    "article_first_workout_category" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getting Started"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "训练起步"
          }
        }
      }
    },
    "article_first_workout_s1_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The goal of your first session is to learn the moves, not to wear yourself out. Choose a light load and keep breathing. If you can’t finish, do fewer reps."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第一次的目标不是练到筋疲力尽，而是熟悉动作。选择轻负荷，保持呼吸。做不完时可以减少次数。"
          }
        }
      }
    },
    "article_first_workout_s1_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start with what you can finish"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从能完成的量开始"
          }
        }
      }
    },
    "article_first_workout_s2_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spread strength training across different days. Rest when you feel clearly tired. You don’t need to make up a session just to keep a check-in."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把力量训练分散到不同的日子。明显疲劳时休息，不用为了打卡补练。"
          }
        }
      }
    },
    "article_first_workout_s2_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make room for recovery"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给恢复留出位置"
          }
        }
      }
    },
    "article_first_workout_s3_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muscle effort is not the same as pain. Stop at once if you feel sharp pain, dizziness or chest discomfort, and get professional help when needed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肌肉用力和疼痛并不相同。出现锐痛、头晕或胸部不适时立即停止，并按情况寻求专业帮助。"
          }
        }
      }
    },
    "article_first_workout_s3_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop if it doesn’t feel right"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不舒服就停下"
          }
        }
      }
    },
    "article_first_workout_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First Workout? No Need to Go All Out"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第一次训练，不必用力过猛"
          }
        }
      }
    },
    "article_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By the Lean Muscle editors · General lifestyle tips, not medical advice."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薄肌编辑内容 · 一般生活提示，不替代医疗建议。"
          }
        }
      }
    },
    "article_meta" : {
      "comment" : "文章列表和文章页的副标题，由分类和预计阅读分钟数组成",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(category)@ · %2$(minutes)lld min read"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(category)@ · %2$(minutes)lld 分钟阅读"
          }
        }
      }
    },
    "article_rest_well_category" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery Habits"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复习惯"
          }
        }
      }
    },
    "article_rest_well_s1_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try a steady routine, and give yourself some time before bed without work. Tracking sleep helps you understand yourself. It isn’t a score to hit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尝试稳定的作息，睡前给自己一段不被工作打扰的时间。记录睡眠是为了了解自己，而不是完成分数。"
          }
        }
      }
    },
    "article_rest_well_s1_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep an evening to unwind"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留一个放松的夜晚"
          }
        }
      }
    },
    "article_rest_well_s2_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you’re tired, rest or choose some easy, comfortable activity. Resting won’t cost you your place in the club."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "疲劳时可以休息，或选择舒适的轻活动。休息不会让你失去俱乐部的入场券。"
          }
        }
      }
    },
    "article_rest_well_s2_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It’s OK to skip today"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天不练，也可以"
          }
        }
      }
    },
    "article_rest_well_s3_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If sleep or fatigue problems keep affecting your life, get professional help. The records in this app are not a medical diagnosis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果睡眠或疲劳问题持续影响生活，寻求专业帮助。App 中的记录不是医学诊断。"
          }
        }
      }
    },
    "article_rest_well_s3_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask for help if it doesn’t go away"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持续不适时求助"
          }
        }
      }
    },
    "article_rest_well_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest Is Part of the Plan"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休息，不是计划之外的事"
          }
        }
      }
    },
    "article_screen_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
