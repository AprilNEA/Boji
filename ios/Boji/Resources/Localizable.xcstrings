          }
        }
      }
    },
    "你的社区权益" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Community Benefits"
          }
        }
      }
    },
    "修改密码" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change Password"
          }
        }
      }
    },
    "修改密码会退出其他会话。仅适用于已设置邮箱密码的账号；Apple 登录账号可继续使用 Apple 登录。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing your password signs out other sessions. This applies only to accounts with an email password. Accounts that use Sign in with Apple can keep using it."
          }
        }
      }
    },
    "修改邮箱登录密码" : {
      "localizations" : {
