{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "App name on the Home Screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lean Muscle"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薄肌"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Camera permission prompt for staff who scan member codes.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lean Muscle scans the member code that a member shows you, to confirm the membership. The camera image is processed on this device and is not uploaded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描会员出示的会员码，确认会员身份。相机画面只在本机识别，不会上传。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Required HealthKit purpose string. Authorization remains read-only; the app never requests write types.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lean Muscle only reads the health data you allow. It does not save or change data in Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薄肌只读取你授权的健康数据，不向「健康」写入或修改记录。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "HealthKit read permission prompt.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lean Muscle reads the sleep, weight and waist data that you allow, to show your recent changes. The data is not uploaded to the club and does not replace your manual records."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取你选择授权的睡眠、体重和腰围，在薄肌展示近期变化。数据不会上传到俱乐部，也不会覆盖手动记录。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
