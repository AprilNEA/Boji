{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "App name on the Home Screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lean Muscle"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薄肌"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Camera permission prompt for staff who scan member codes.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lean Muscle scans the member code that a member shows you, to confirm the membership. The camera image is processed on this device and is not uploaded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描会员出示的会员码，确认会员身份。相机画面只在本机识别，不会上传。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "HealthKit write permission prompt. The app requests write permission for workouts, weight and waist only after the user turns on writing.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lean Muscle saves the workouts that you finish and the weight and waist that you log in the app to Apple Health. It saves only the types that you allow."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把你在薄肌完成的训练和记录的体重、腰围写入 Apple 健康。只写入你允许的类型。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "HealthKit read permission prompt.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lean Muscle reads the sleep, weight and waist data that you allow, to show your recent changes. The data is not uploaded to the club and does not replace your manual records."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取你选择授权的睡眠、体重和腰围，在薄肌展示近期变化。数据不会上传到俱乐部，也不会覆盖手动记录。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
