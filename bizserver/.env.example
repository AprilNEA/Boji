# 开发用途。先生成独立密钥，禁止复用生产数据库。
APP_ENV=development
HOST=127.0.0.1
PORT=3000
POSTGRES_PASSWORD=replace-with-local-database-password
DATABASE_URL=postgresql://boji:replace-with-local-database-password@127.0.0.1:55439/boji_rust
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGINS=
TRUSTED_ORIGINS=
RUST_LOG=off,boji_bizserver=info
# 邮件。SMTP_HOST 留空时，开发环境把邮件写入 MAIL_OUTPUT_DIR，生产环境拒绝启动。
# 填写 SMTP_HOST 时，MAIL_FROM 必填，MAIL_OUTPUT_DIR 不再生效。
MAIL_OUTPUT_DIR=.data/mail
MAIL_FROM=
SMTP_HOST=
# tls（通常是 465 端口）、starttls（默认，通常是 587 端口）或 none。生产环境不接受 none。
SMTP_TLS=
# 留空时按 SMTP_TLS 取默认端口。
SMTP_PORT=
# 用户名和密码同时填写或同时留空。
SMTP_USERNAME=
SMTP_PASSWORD=
# 客户端 IP。留空时会话不记录 IP。填写网关覆盖写入的请求头，例如 cf-connecting-ip。
CLIENT_IP_HEADER=
# 用逗号分隔的 IP 或 CIDR。只在 CLIENT_IP_HEADER 是转发链时填写，例如 x-forwarded-for。
TRUSTED_PROXIES=
# Sentry 错误上报。SENTRY_DSN 留空则关闭。环境默认取 APP_ENV，版本默认为 boji-bizserver@<版本号>。
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Apple 登录。5 项全部填写才启用，全部留空则关闭。私钥换行写成 \n。
APPLE_CLIENT_ID=
APPLE_APP_BUNDLE_IDENTIFIER=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# 社交登录邮箱已属于现有用户时是否关联：disabled（默认）或 enabled。
ACCOUNT_LINKING=disabled
# Apple Wallet 会员卡。除口令外全部填写才启用，全部留空则关闭。PEM 换行写成 \n。
# 启动时校验证书链和私钥。证书不在有效期内时，服务照常启动，但不签发通行证。
WALLET_PASS_TYPE_IDENTIFIER=
WALLET_TEAM_IDENTIFIER=
WALLET_ORGANIZATION_NAME=
WALLET_SIGNER_CERT=
WALLET_SIGNER_KEY=
# 私钥加密时填写。
WALLET_SIGNER_KEY_PASSPHRASE=
WALLET_WWDR_CERT=
# 学校邮箱认证。留空则关闭。至少 32 字节，不能等于 BETTER_AUTH_SECRET。上线后不要更换。
AFFILIATION_EMAIL_HMAC_KEY=
